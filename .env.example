# Copy to .env and export the variables (or set them in your shell). All are optional.
ROBERTA_MODEL_NAME=openai-community/roberta-base-openai-detector
PERPLEXITY_MODEL_NAME=gpt2
DEVICE=cpu
ENABLE_ROBERTA=true
ENABLE_PERPLEXITY=true
PRELOAD_MODELS=false
MIN_WORDS=10
RELIABLE_WORDS=50
MAX_CHARS=20000
DATABASE_URL=sqlite:///./data/detections.db
STORE_RAW_TEXT=false
AUTO_SAVE_HISTORY=true
